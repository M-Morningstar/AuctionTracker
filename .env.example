# Database (PostgreSQL 16 in Docker)
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction

# Used by local host-side tooling (alembic / uvicorn run from your machine).
# The docker-compose FastAPI service overrides this to point at the container.
DATABASE_URL=postgresql+asyncpg://auction:auction@localhost:5433/auction

# --- Added in later phases (keep as empty placeholders for now) ---
# Phase 1: HiBid scraper needs no secret.
# Phase 2: local Ollama endpoint + model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Phase 3: eBay developer credentials (active-listing asking-price comps).
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
# eBay marketplace for comps. EBAY_CA = Canada (CAD, matches our auction items);
# switch to EBAY_US only if you add FX conversion in Phase 4.
EBAY_MARKETPLACE_ID=EBAY_CA
# A valuation is "fresh" for this many seconds before providers are re-queried.
VALUATION_CACHE_TTL_SECONDS=86400
# Phase 5: Discord webhook.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here